# Variables publiques (préfixe VITE_ — exposées au navigateur, clé PUBLISHABLE uniquement)
VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VOTRE_CLE

# NE JAMAIS mettre de clé service_role, de secret Meta ou d'autre secret
# dans une variable VITE_* ni dans le dépôt Git.

# Secrets configurés UNIQUEMENT côté serveur (Supabase Edge Functions) :
# supabase secrets set WHATSAPP_ACCESS_TOKEN="..." WHATSAPP_PHONE_NUMBER_ID="..." #   WHATSAPP_BUSINESS_ACCOUNT_ID="..." WHATSAPP_VERIFY_TOKEN="..." #   WHATSAPP_APP_SECRET="..." WHATSAPP_API_VERSION="v23.0" #   WHATSAPP_TEMPLATE_NAME="bielumina_order_update" CRON_SECRET="..."
# APP_BASE_URL=https://votre-domaine.tld (utilisé pour le callback webhook Meta)
